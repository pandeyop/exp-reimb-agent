# Copy to .env and adjust. Everything has a sensible default.

# --- AI layer -------------------------------------------------------------
# auto    : read documents with Claude if Anthropic credentials exist, else OpenAI if OPENAI_API_KEY is set,
#           otherwise offline demo mode (default)
# claude  : always use Claude    openai : always use OpenAI   (documents that fail to extract need manual entry)
# offline : never call an API — replays recorded extractions for the bundled demo receipts
# In every mode the 12 bundled demo receipts replay their recorded extractions and never call an API.
EXTRACTION_MODE=auto
# Credentials are read by the Anthropic SDK: ANTHROPIC_API_KEY, ANTHROPIC_AUTH_TOKEN or an `ant auth login` profile.
# ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=low
ANTHROPIC_TIMEOUT_SECONDS=90
# Server-side refusal fallback (beta). Set to false if your account/platform rejects it.
ANTHROPIC_REFUSAL_FALLBACK=true
# Optional OpenAI document reading (photos and PDFs only; free-text chat stays rule-based without Claude).
# OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5.4-mini
OPENAI_TIMEOUT_SECONDS=90

# --- Demo determinism -----------------------------------------------------
# "Today" for age / future-date rules. The demo receipts are dated 21–24 Sep 2026;
# pin this so the 60-day staleness warning doesn't fire when you demo later.
REFERENCE_DATE=2026-10-07
# Simulated per-document latency in offline mode, so the pipeline animation is visible.
OFFLINE_PROCESSING_DELAY=0.9

# --- Limits ---------------------------------------------------------------
MAX_UPLOAD_MB=10
MAX_FILES_PER_UPLOAD=30
WORKER_THREADS=4

# --- Demo identity / mock finance API ---------------------------------------
DEMO_EMPLOYEE_ID=EMP001
DEMO_EMPLOYEE_NAME=Demo Employee
# Probability (0–1) that the mock reimbursement API fails, to demo error handling.
MOCK_FINANCE_FAILURE_RATE=0
